{
  "name": "agentic-mailbox",
  "version": "0.0.1-beta1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && wrangler deploy --dry-run --outdir .wrangler/local-worker && node scripts/local.mjs",
    "dev": "npm run build && wrangler dev --local",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:editions": "npm run build && wrangler deploy --dry-run --outdir .wrangler/local-worker && node scripts/test-editions.mjs",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && wrangler deploy --dry-run",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/kumo": "1.13.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tiptap/react": "3.20.6",
    "@tiptap/starter-kit": "3.20.6",
    "dompurify": "3.3.3",
    "imapflow": "2.12.2",
    "jose": "6.2.18",
    "lucide-react": "1.25.0",
    "nodemailer": "10.6.1",
    "openai": "7.62.0",
    "postal-mime": "2.7.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "30.0.1",
    "miniflare": "4.20260714.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
