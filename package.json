{
  "name": "agentic-mailbox",
  "version": "0.0.1-beta1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run build && wrangler dev --local",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:routing",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.self-hosted.jsonc",
    "deploy:self-hosted": "npm run build && wrangler deploy --config wrangler.self-hosted.jsonc",
    "test:routing": "wrangler deploy --dry-run --outdir .wrangler/routing-test && node scripts/test-routing.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "30.0.1",
    "miniflare": "4.20260714.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
