{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-postway",
  "main": "src/worker/self-host.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-postway",
      "migrations_dir": "migrations-imap"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "ADMIN_EMAIL": "owner"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
