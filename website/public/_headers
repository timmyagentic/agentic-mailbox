/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self'; media-src 'self'; script-src 'sha384-3JQ1aQsohK0X+YXURyS8+FygpBJKR3wDYIR9YC40V8fjPbUpGjlnsryw16Uy84ae'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  Cache-Control: public, max-age=3600
