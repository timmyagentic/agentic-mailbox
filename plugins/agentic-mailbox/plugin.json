{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agentic-mailbox",
  "version": "0.2.0",
  "description": "Manage forwarding destinations, relay addresses and domain aliases.",
  "author": {
    "name": "Agentic Mailbox contributors"
  },
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Agentic Mailbox",
        "shortDescription": "Manage email forwarding",
        "category": "Productivity",
        "developerName": "Agentic Mailbox contributors",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": "Show my forwarding destination and relay address."
      }
    }
  }
}
