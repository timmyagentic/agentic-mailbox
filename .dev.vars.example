ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Set a unique key generated by: openssl rand -base64 32
MAIL_ACCOUNT_KEY=
# Optional SHA-256 client certificate fingerprints, comma separated.
ADMIN_CERT_FINGERPRINTS=

# Optional mailbox OAuth clients. Register this exact origin's callback URLs.
MAIL_OAUTH_ORIGIN=http://localhost:8787
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
