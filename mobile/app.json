{
  "expo": {
    "name": "Agentic Mailbox",
    "slug": "agentic-mailbox",
    "version": "0.0.1",
    "scheme": "agentic-mailbox",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "si.timmyagentic.mailbox"
    },
    "android": {
      "package": "si.timmyagentic.mailbox"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "扫描 Mac 上的邮箱导入二维码。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
